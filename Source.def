LIBRARY "wzAudio"
EXPORTS
    wzAudioCreate                  @1
    wzAudioDestroy                 @2
    wzAudioGetStreamInfo           @3
    wzAudioGetStreamOffsetRange    @4
    wzAudioGetStreamOffsetSec      @5
    wzAudioGetVolume               @6
    wzAudioOpenFile                @7
    wzAudioOption                  @8
    wzAudioPause                   @9
    wzAudioPlay                    @10
    wzAudioSeek                    @11
    wzAudioSetEqualizer            @12
    wzAudioSetMixerMode            @13

    wzAudioVolumeDown              @16
    wzAudioVolumeUp                @17
